# Banco local. Copie este arquivo para .env e troque todos os placeholders.
POSTGRES_DB=ponto
POSTGRES_USER=ponto_app
POSTGRES_PASSWORD=ALTERE_A_SENHA_DO_BANCO

# Único gerente criado no primeiro start. A senha deve ter de 12 a 72 bytes em UTF-8.
MANAGER_EMAIL=gerente@empresa.local
MANAGER_PASSWORD=ALTERE_A_SENHA_DO_GERENTE

# Gere com: openssl rand -base64 32
JWT_SECRET_BASE64=ALTERE_POR_32_BYTES_ALEATORIOS_EM_BASE64

# Local fictício usado na demonstração (centro de São Paulo).
WORKPLACE_LATITUDE=-23.55052
WORKPLACE_LONGITUDE=-46.63331
WORKPLACE_RADIUS_METERS=150
WORKPLACE_MAX_ACCURACY_METERS=50
